# Default ESP-IDF settings for this project.
# ESP-IDF will use these values when creating a new sdkconfig file.

# Target the ESP32-P4 family used by the Waveshare board.
CONFIG_IDF_TARGET="esp32p4"

# Support the earlier ESP32-P4 silicon used by this Waveshare board.
# The detected chip revision is v1.3, so the project must target the
# "<3.0" silicon family and accept chips starting from v1.0.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ESP32-P4 reaches Wi-Fi through the board's ESP32-C6 coprocessor.
# Host Wi-Fi and Wi-Fi Remote are mutually exclusive with the locked components.
# Keep the remote API and its ESP-HOSTED backend enabled together.
# CONFIG_ESP_HOST_WIFI_ENABLED is not set
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# Board-tested four-bit SDIO wiring. Set the selectable slot-specific GPIOs;
# generated ESP_HOSTED_SDIO_PIN_* / SLOT / BUS_WIDTH values are derived.
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
# In this component the HIGH option uses High -> Low -> High to reset the C6.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y

# Real network settings belong only in the ignored local sdkconfig.
CONFIG_APP_WIFI_SSID="CHANGE_ME_WIFI_SSID"
CONFIG_APP_WIFI_PASSWORD="CHANGE_ME_WIFI_PASSWORD"
CONFIG_APP_WIFI_MAXIMUM_RETRY_COUNT=5

# The 7-inch MIPI display path allocates full frame buffers from PSRAM.
# Without PSRAM enabled, the Waveshare BSP panics during display startup
# with "no memory for frame buffer" inside esp_lcd_new_panel_dpi().
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Keep logs readable for early development.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Match the image header to the Waveshare board's detected 32 MB flash.
# Keep the bootloader image digest intact by using a fixed configured size
# instead of runtime flash-size patching during flashing.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# Use a project-local partition table so the single factory app has enough room
# for the display + hosted Wi-Fi firmware without enabling OTA yet.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
